{
    "name": "@kuzulabz/react-native-nitro-vibrato",
    "version": "0.0.0",
    "description": "react-native-nitro-vibrato",
    "main": "lib/index",
    "module": "lib/index",
    "types": "lib/index.d.ts",
    "react-native": "src/index",
    "source": "src/index",
    "files": [
        "src",
        "react-native.config.js",
        "lib",
        "nitrogen",
        "android/build.gradle",
        "android/gradle.properties",
        "android/fix-prefab.gradle",
        "android/CMakeLists.txt",
        "android/src",
        "cpp",
        "ios/**/*.h",
        "ios/**/*.m",
        "ios/**/*.mm",
        "ios/**/*.cpp",
        "ios/**/*.swift",
        "app.plugin.js",
        "nitro.json",
        "*.podspec",
        "README.md"
    ],
    "scripts": {
        "typecheck": "tsc --noEmit",
        "clean": "rm -rf android/build node_modules/**/android/build lib",
        "release": "release-it",
        "specs": "tsc --noEmit false && nitrogen --logLevel=\"debug\"",
        "build:wasm": "cd rust/vibrato-nitro/wasm && wasm-pack build --target web --out-dir ../../../web",
        "build:android": "./scripts/android-build.sh",
        "build:ios": "./scripts/ios-build.sh"
    },
    "keywords": [
        "react-native",
        "react-native-nitro-mecab",
        "nitro",
        "vibrato",
        "japanese",
        "tokenization",
        "segmentation",
        "language"
    ],
    "repository": "https://github.com/KuzuLabz/react-native-nitro-vibrato.git",
    "author": "KuzuLabz",
    "license": "MIT",
    "bugs": "https://github.com/KuzuLabz/react-native-nitro-vibrato/issues",
    "homepage": "https://kuzulabz.com/docs/react-native/mecab",
    "publishConfig": {
        "registry": "https://registry.npmjs.org/"
    },
    "devDependencies": {
        "@react-native/eslint-config": "0.85.3",
        "@types/react": "^19.2.15",
        "eslint": "^9.39.4",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.5",
        "nitrogen": "*",
        "prettier": "^3.8.3",
        "react": "19.2.3",
        "react-native": "0.85.3",
        "react-native-nitro-modules": "*",
        "typescript": "^6.0.3"
    },
    "peerDependencies": {
        "react": "*",
        "react-native": "*",
        "react-native-nitro-modules": "*"
    },
    "eslintConfig": {
        "root": true,
        "extends": [
            "@react-native",
            "prettier"
        ],
        "plugins": [
            "prettier"
        ],
        "rules": {
            "prettier/prettier": [
                "warn",
                {
                    "quoteProps": "consistent",
                    "singleQuote": true,
                    "tabWidth": 2,
                    "trailingComma": "es5",
                    "useTabs": false
                }
            ]
        }
    },
    "eslintIgnore": [
        "node_modules/",
        "lib/"
    ],
    "prettier": {
        "quoteProps": "consistent",
        "singleQuote": true,
        "tabWidth": 2,
        "trailingComma": "es5",
        "useTabs": false,
        "semi": false
    },
    "react-native-builder-bob": {
        "source": "src",
        "output": "lib",
        "targets": [
            "commonjs",
            "module",
            [
                "typescript",
                {
                    "project": "tsconfig.json"
                }
            ]
        ]
    },
    "release-it": {
        "npm": {
            "publish": false
        },
        "git": false,
        "github": {
            "release": false
        }
    }
}